rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Centros de diálisis y estaciones/sillones
    match /dialysisCenters/{centerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(request.resource.data.createdBy);
    }

    // Pacientes crónicos (Confidencialidad médica Ley 26.529)
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // Filtros dializadores capilares y reprocesamiento
    match /dialyzers/{dialyzerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // Registros matutinos y de turno de planta de agua (Ósmosis Inversa)
    match /waterQualityGates/{gateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // Sesiones de hemodiálisis y planillas horarias
    match /dialysisSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // Lotes mensuales de facturación de Módulos PAMI / Obras Sociales
    match /pamiBatches/{batchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
  }
}
